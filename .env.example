# Copy this file to `.env` and fill in your own project's values.
# `.env` is gitignored — never commit real values.
#
# Both of these come from your Supabase project's dashboard:
# Project Settings → API.
#
# EXPO_PUBLIC_SUPABASE_ANON_KEY is safe to ship in the app bundle — it's
# the "publishable" key, meant to be public. Row Level Security (see
# docs/DESIGN.md, Phase 3) is what actually protects data, not secrecy of
# this key. NEVER put the service_role key or your database password in
# this file, or anywhere in the app — the app never needs either.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
